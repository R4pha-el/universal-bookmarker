// Copy to Secrets.xcconfig. Use your own identifiers and Apple development team.
APP_BUNDLE_IDENTIFIER = com.yourcompany.universalbookmarker
APP_GROUP_IDENTIFIER = group.$(APP_BUNDLE_IDENTIFIER)
DEVELOPMENT_TEAM = YOUR_TEAM_ID
// The empty $() prevents // being interpreted as an xcconfig comment.
SUPABASE_URL = https:/$()/YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY = YOUR_CLIENT_PUBLISHABLE_KEY
// Never add a service-role key here.
